# Analysis outputs (regenerated by run_all.sh)
code_outputs/

# R's default graphics device, if a script auto-prints a plot
Rplots.pdf

# Restricted data (shared separately). No trailing slash: `data` is a symlink
# to the data tree here, and `data/` would match only a real directory, leaving
# the symlink -- an absolute path into one machine's filesystem -- committed.
data
